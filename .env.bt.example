# 首次部署无需填写，访问 /install 后由安装向导保存宝塔 MySQL 配置。
DATABASE_URL=

YEHAOPROXY_IMAGE=ghcr.io/yehao9589/yehaoproxy:v1.0.0
YEHAOPROXY_UPDATER_IMAGE=ghcr.io/yehao9589/yehaoproxy-updater:v1.0.0
APP_PORT=3000
PUBLIC_APP_URL=http://服务器IP:3000
APP_VERSION=v1.0.0

# 内部服务认证与代理资产加密密钥由单容器首次启动时自动生成，
# 持久化保存在 /www/wwwroot/yehaoproxy/data/system-secrets.json，无需手工填写。

CRON_INTERVAL_MS=60000
