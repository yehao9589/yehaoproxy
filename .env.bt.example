# 首次部署无需填写，访问 /install 后由安装向导保存宝塔 MySQL 配置。
DATABASE_URL=

YEHAOPROXY_IMAGE=ghcr.io/yehao9589/yehaoproxy:pre-release
YEHAOPROXY_UPDATER_IMAGE=ghcr.io/yehao9589/yehaoproxy-updater:pre-release
APP_PORT=3000
PUBLIC_APP_URL=http://服务器IP:3000
APP_VERSION=pre-release

# 以下每项都换成独立的 32 位以上随机字符串。
INVENTORY_ENCRYPTION_KEY=
INSTALL_TOKEN=
MYSQL_BRIDGE_SECRET=
CRON_SECRET=
XPANEL_BRIDGE_SECRET=
UPDATE_WEBHOOK_TOKEN=

CRON_INTERVAL_MS=60000
