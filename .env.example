# Required in production. Use a randomly generated value of at least 32 characters.
INVENTORY_ENCRYPTION_KEY=

# Comma-separated bootstrap administrators. Remove after admin roles are seeded.
ADMIN_EMAILS=

# Email is optional until enabled in the admin console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# Recommended email delivery provider for Cloudflare Workers.
EMAIL_API_KEY=

# Optional public URL used in notification links.
PUBLIC_APP_URL=http://localhost:3000

# Database driver: mysql (recommended) or sqlite.
# For local Docker MySQL run: docker compose --profile mysql up -d mysql
DATABASE_DRIVER=mysql
DATABASE_URL=mysql://yehaoproxy:change-this-database-password@mysql:3306/yehaoproxy?charset=utf8mb4
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=yehaoproxy
MYSQL_USER=yehaoproxy
MYSQL_PASSWORD=change-this-database-password
MYSQL_BRIDGE_URL=http://mysql-bridge:8789
MYSQL_BRIDGE_SECRET=replace-with-a-long-random-secret

# Required by the production Docker stack.
YEHAOPROXY_IMAGE=ghcr.io/yehao9589/yehaoproxy:pre-release
YEHAOPROXY_UPDATER_IMAGE=ghcr.io/yehao9589/yehaoproxy-updater:pre-release
APP_PORT=3000
CRON_SECRET=replace-with-a-long-random-secret
XPANEL_BRIDGE_SECRET=replace-with-a-long-random-secret
UPDATE_WEBHOOK_TOKEN=replace-with-a-long-random-secret
